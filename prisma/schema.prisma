generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskType {
  CLEANING
  MAINTENANCE
  PROJECT
}

enum TaskStatus {
  TODO
  DONE
  CANCELLED
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShoppingTripStatus {
  NOT_STARTED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ShoppingTripItemStatus {
  PENDING
  PARSED
  NEEDS_REVIEW
  CONFIRMED
  APPLIED
  REJECTED
}

enum CaptureJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ShoppingDealType {
  SALE
  MULTI_BUY
}

enum InventoryTrackingMode {
  COUNT
  LEVEL
  NONE
}

enum InventoryItemStatus {
  FULL
  HALF
  LOW
}

model User {
  id                  String           @id @unique @default(uuid())
  email               String           @unique
  passwordHash        String?          @map("password_hash")
  firstName           String?          @map("first_name")
  lastName            String?          @map("last_name")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  homes               Home[]
  homeMemberships     HomeMember[]
  homeInvitationsSent HomeInvitation[] @relation("HomeInvitationInviter")
  assignedTasks       Task[]           @relation("TaskAssignee")
  assignedProjects    Project[]        @relation("ProjectAssignee")

  @@map("users")
}

model Home {
  id            BigInt           @id @default(autoincrement())
  name          String
  ownerId       String           @map("owner_id")
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  rooms         Room[]
  projects      Project[]
  tasks         Task[]
  inventory     Inventory[]
  shoppingTrips ShoppingTrip[]
  members       HomeMember[]
  invitations   HomeInvitation[]
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@map("homes")
}

model HomeMember {
  homeId   BigInt   @map("home_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")
  home     Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([homeId, userId])
  @@map("home_members")
}

model HomeInvitation {
  id          BigInt    @id @default(autoincrement())
  email       String
  tokenHash   String    @unique @map("token_hash")
  homeId      BigInt    @map("home_id")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("HomeInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([homeId, email])
  @@map("home_invitations")
}

model Room {
  id        BigInt      @id @default(autoincrement())
  name      String
  roomEmoji String?     @map("room_emoji")
  homeId    BigInt      @map("home_id")
  home      Home        @relation(fields: [homeId], references: [id], onDelete: Cascade)
  projects  Project[]
  tasks     Task[]
  inventory Inventory[]
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  notes     Note[]

  @@map("rooms")
}

model Project {
  id                   BigInt            @id @default(autoincrement())
  name                 String
  description          String?
  status               ProjectStatus     @default(NOT_STARTED)
  targetCompletionDate DateTime?         @map("target_completion_date") @db.Date
  completedDate        DateTime?         @map("completed_date") @db.Date
  estimatedCost        Decimal?          @map("estimated_cost") @db.Decimal(12, 2)
  actualCost           Decimal?          @map("actual_cost") @db.Decimal(12, 2)
  homeId               BigInt            @map("home_id")
  home                 Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId               BigInt?           @map("room_id")
  room                 Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  assigneeId           String?           @map("assignee_id")
  assignee             User?             @relation("ProjectAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  tasks                Task[]
  materials            ProjectMaterial[]
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@map("projects")
}

model ProjectMaterial {
  id        BigInt   @id @default(autoincrement())
  name      String
  quantity  Int      @default(1)
  unitCost  Decimal? @map("unit_cost") @db.Decimal(12, 2)
  purchased Boolean  @default(false)
  projectId BigInt   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("project_materials")
}

model Task {
  id                  BigInt              @id @default(autoincrement())
  title               String
  notes               String?
  type                TaskType
  status              TaskStatus          @default(TODO)
  dueDate             DateTime?           @map("due_date") @db.Date
  completedAt         DateTime?           @map("completed_at")
  recurrenceFrequency RecurrenceFrequency @default(NONE) @map("recurrence_frequency")
  recurrenceInterval  Int                 @default(1) @map("recurrence_interval")
  homeId              BigInt              @map("home_id")
  home                Home                @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId              BigInt?             @map("room_id")
  room                Room?               @relation(fields: [roomId], references: [id], onDelete: SetNull)
  projectId           BigInt?             @map("project_id")
  project             Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assigneeId          String?             @map("assignee_id")
  assignee            User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("task")
}

model Inventory {
  id               BigInt                @id @default(autoincrement())
  name             String
  description      String?
  category         String                @default("Uncategorized")
  quantity         Int
  link             String?
  minQuantity      Int                   @map("min_quantity")
  price            Decimal?              @db.Decimal(12, 2)
  lastPurchaseDate DateTime?             @map("last_purchase_date") @db.Date
  expiresDate      DateTime?             @map("expires_date") @db.Date
  tags             String[]              @default([])
  homeId           BigInt                @map("home_id")
  home             Home                  @relation(fields: [homeId], references: [id], onDelete: Cascade)
  roomId           BigInt?               @map("room_id")
  room             Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  shoppingItems    ShoppingTripItem[]
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  status           InventoryItemStatus   @default(FULL)
  trackingMode     InventoryTrackingMode @default(COUNT) @map("tracking_mode")
  notes            String?
  stores           String[]              @default([])

  @@map("inventory")
}

model ShoppingTrip {
  id            BigInt             @id @default(autoincrement())
  name          String
  description   String?
  runningTotal  Decimal            @default(0) @map("running_total") @db.Decimal(12, 2)
  totalCost     Decimal            @default(0) @map("total_cost") @db.Decimal(12, 2)
  budget        Decimal            @default(0) @db.Decimal(12, 2)
  startDate     DateTime?          @map("start_date")
  completedDate DateTime?          @map("completed_date")
  status        ShoppingTripStatus @default(NOT_STARTED)
  homeId        BigInt             @map("home_id")
  home          Home               @relation(fields: [homeId], references: [id], onDelete: Cascade)
  items         ShoppingTripItem[]
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@map("shopping_trips")
}

model ShoppingCaptureJob {
  id        BigInt             @id @default(autoincrement())
  audioRef  String?            @map("audio_ref")
  textRef   String?            @map("text_ref")
  attempts  Int                @default(1)
  lastError String?            @map("last_error")
  status    CaptureJobStatus   @default(PENDING)
  items     ShoppingTripItem[]
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@map("shopping_capture_job")
}

model ShoppingTripItem {
  id                      BigInt                 @id @default(autoincrement())
  rawTranscript           String                 @map("raw_transcript")
  name                    String?
  quantity                Int?
  price                   Decimal                @default(0) @db.Decimal(12, 2)
  regularPrice            Decimal?               @map("regular_price") @db.Decimal(12, 2)
  dealType                ShoppingDealType?      @map("deal_type")
  multiBuyQuantity        Int?                   @map("multi_buy_quantity")
  multiBuyPrice           Decimal?               @map("multi_buy_price") @db.Decimal(12, 2)
  confidence              Float?
  status                  ShoppingTripItemStatus @default(PENDING)
  lowStockInventoryItemId BigInt?                @map("low_stock_inventory_item_id")
  inventoryItemId         BigInt?                @map("inventory_item_id")
  inventoryItem           Inventory?             @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  shoppingTripId          BigInt?                @map("shopping_trip_id")
  shoppingTrip            ShoppingTrip?          @relation(fields: [shoppingTripId], references: [id], onDelete: Cascade)
  captureJobId            BigInt?                @map("capture_job_id")
  captureJob              ShoppingCaptureJob?    @relation(fields: [captureJobId], references: [id], onDelete: SetNull)
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  @@map("shopping_trip_items")
}

model Note {
  id        BigInt   @id @default(autoincrement())
  content   String
  roomId    BigInt   @map("room_id")
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}
